--- !u!114 &428397402
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 428397400}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e09d1dd697d2e4bcaab854e7106e56c3, type: 3}
  m_Name:
  m_EditorClassIdentifier: ObstacleCourse::ObstacleCourse.TutorialGuide
  tips:
  - area:
      serializedVersion: 2
      x: -14.85
      y: -4.9
      width: 8.35
      height: 5
    target: {fileID: 2059019209}
    cardPosition: {x: -10.7, y: 2.6}
    message: "Encostar nos obst\xE1culos m\xF3veis encerra a tentativa. Observe o
      movimento antes de avan\xE7ar."
  - area:
      serializedVersion: 2
      x: -14.85
      y: 2
      width: 9.15
      height: 4
    target: {fileID: 1964985363}
    cardPosition: {x: -10.7, y: 0}
    message: "Por cima do port\xE3o \xE9 mais seguro. Por baixo, o atalho \xE9 mais
      r\xE1pido, mas exige acertar o momento."
  - area:
      serializedVersion: 2
      x: -5.7
      y: 2.25
      width: 8.3
      height: 3.75
    target: {fileID: 2145427138}
    cardPosition: {x: -1.45, y: -2.7}
    message: "Este port\xE3o vai e volta. Espere ele se afastar e atravesse antes
      que retorne."
  - area:
      serializedVersion: 2
      x: -5.7
      y: -0.6
      width: 8.3
      height: 2.85
    target: {fileID: 1940427573}
    cardPosition: {x: -1.45, y: 3.4}
    message: "Este piso d\xE1 choque. Passe sem corrente; no alerta amarelo, espere.
      O piso vermelho \xE9 fatal."
  - area:
      serializedVersion: 2
      x: -5.7
      y: -3.3
      width: 8.3
      height: 2.7
    target: {fileID: 2098554288}
    cardPosition: {x: -1.45, y: 1.25}
    message: "O piso molhado deixa voc\xEA mais lento. Contorne a \xE1gua para ganhar
      tempo."
  - area:
      serializedVersion: 2
      x: 7
      y: -2.8
      width: 7.85
      height: 4.9
    target: {fileID: 536604287}
    cardPosition: {x: 10.8, y: 4.6}
    message: "O guarda come\xE7a a perseguir quando voc\xEA se aproxima. Se ele alcan\xE7ar
      voc\xEA, a fuga termina."
  layout: {fileID: 428397401}
  card: {fileID: 1912989875}
  pointer: {fileID: 1279803702}
  marker: {fileID: 1503662724}
  message: {fileID: 823434537}
