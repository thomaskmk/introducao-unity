--- !u!114 &1842040299
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1842040297}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e09d1dd697d2e4bcaab854e7106e56c3, type: 3}
  m_Name:
  m_EditorClassIdentifier: ObstacleCourse::ObstacleCourse.TutorialGuide
  tips:
  - area:
      serializedVersion: 2
      x: -14.85
      y: -4.9
      width: 8.35
      height: 5
    target: {fileID: 1898693305}
    cardPosition: {x: -10.7, y: 2.6}
    message: "Use WASD ou as setas. Espere a abertura \xE0 direita do eixo e acompanhe
      o giro para passar."
  - area:
      serializedVersion: 2
      x: -14.85
      y: 2
      width: 9.15
      height: 4
    target: {fileID: 1539931034}
    cardPosition: {x: -10.7, y: 0}
    message: "Por cima do port\xE3o \xE9 mais seguro. Por baixo, o atalho \xE9 mais
      r\xE1pido, mas exige acertar o momento."
  - area:
      serializedVersion: 2
      x: -5.7
      y: 2.25
      width: 8.3
      height: 3.75
    target: {fileID: 1307166060}
    cardPosition: {x: -1.45, y: -2.7}
    message: "Este port\xE3o vai e volta. Espere ele se afastar e atravesse antes
      que retorne."
  - area:
      serializedVersion: 2
      x: -5.7
      y: -0.6
      width: 8.3
      height: 2.85
    target: {fileID: 969316362}
    cardPosition: {x: -1.45, y: 3.4}
    message: "Este piso d\xE1 choque. Passe sem corrente; no alerta amarelo, espere.
      O piso vermelho \xE9 fatal."
  - area:
      serializedVersion: 2
      x: -5.7
      y: -3.3
      width: 8.3
      height: 2.7
    target: {fileID: 1581622729}
    cardPosition: {x: -1.45, y: 1.25}
    message: "O piso molhado deixa voc\xEA mais lento. Contorne a \xE1gua para ganhar
      tempo."
  - area:
      serializedVersion: 2
      x: -5.7
      y: -6
      width: 12.1
      height: 2.7
    target: {fileID: 514592243}
    cardPosition: {x: 5.1, y: -1.6}
    message: "A passagem continua por baixo da parede. Espere o port\xE3o se afastar
      antes de contorn\xE1-la."
  - area:
      serializedVersion: 2
      x: 7
      y: -2.8
      width: 7.85
      height: 4.9
    target: {fileID: 321204608}
    cardPosition: {x: 10.8, y: 4.6}
    message: "Aproxime-se para atrair o guarda. Recue, d\xEA a volta nele e use a
      passagem que ele deixou livre."
  layout: {fileID: 1842040298}
  card: {fileID: 1038122614}
  pointer: {fileID: 488616952}
  marker: {fileID: 1805813381}
  message: {fileID: 1356121062}
